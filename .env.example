# 大模型服务配置（OpenAI 兼容协议；GLM、通义千问等均提供兼容端点）
# 示例（智谱 GLM）：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PORT=8787

# 前端构建期变量（可选）：线上环境 AI 代理的完整地址，不设则默认同源 /api（开发期走 vite 代理）
# 示例：VITE_AI_BASE_URL=https://your-proxy.example.com
VITE_AI_BASE_URL=
