%% 学生端系统架构图 — 对应 spec/04-架构设计.md §1
flowchart LR
  subgraph Client["学生端浏览器（Vue 3 SPA）"]
    UI["界面层<br/>投影推荐视图 · 符号设计视图"]
    PM["投影模块 projection/<br/>规则引擎 · AI 客户端 · 知识库"]
    SM["符号模块 symbol/<br/>规范化校验 · 符号库"]
    PV["投影预览（规划）<br/>d3-geo + Tissot"]
    UI --> PM
    UI --> SM
    PM --> PV
  end

  subgraph Server["服务端（轻量）"]
    AP["AI 代理 ai-proxy<br/>保管密钥 · 拼装 prompt · 超时控制"]
  end

  LLM[("通用大模型 API<br/>GPT / GLM / 通义千问")]
  LS[("本地持久化<br/>localStorage / JSON 导出")]

  subgraph External["外部工具（学生本地离线操作）"]
    IF["iconfont 网站<br/>AI 生成基础符号 SVG"]
    AI["Adobe Illustrator<br/>专业化设计与导出"]
  end

  PM -->|"HTTPS /api/ai/recommend"| AP
  AP -->|"Bearer Key"| LLM
  SM --> LS
  UI -. "步骤引导 + 描述词" .-> IF
  IF -. "下载 SVG" .-> AI
  AI -. "导出规范 SVG" .-> SM
