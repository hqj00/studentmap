{
  "name": "studentmap",
  "version": "0.1.0",
  "private": true,
  "description": "学生端 · 地图投影智能推荐与地图符号设计",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/ai-proxy.mjs",
    "class-server": "node server/class-server.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.2",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "element-plus": "^2.8.8",
    "proj4": "^2.22.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/proj4": "^2.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.13"
  }
}
